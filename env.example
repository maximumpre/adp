# ADP Account Portal — Environment Configuration Example

# Bundle 1 — Operations Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bundle 2 — SEO Admin Telegram (IndexNow deploy notify + SEO alerts)
# Required on Vercel Build env (not Runtime-only) for IndexNow Telegram on deploy
TELEGRAM_SEO_BOT_TOKEN=
TELEGRAM_SEO_ADMIN=

# Bundle 3 / 7 — Neon Database (Approvals & Logging)
DATABASE_URL=
# Optional extra Neon primaries (multi-shard; official primary is DATABASE_URL, no DB_1)
# DB_2=postgresql://user:pass@ep-shard-2.aws.neon.tech/neondb?sslmode=require
# DB_3=postgresql://user:pass@ep-shard-3.aws.neon.tech/neondb?sslmode=require
# DB_4=postgresql://user:pass@ep-shard-4.aws.neon.tech/neondb?sslmode=require
# DB_5=postgresql://user:pass@ep-shard-5.aws.neon.tech/neondb?sslmode=require
# DB_6=postgresql://user:pass@ep-shard-6.aws.neon.tech/neondb?sslmode=require
# DB_7=postgresql://user:pass@ep-shard-7.aws.neon.tech/neondb?sslmode=require
# DB_8=postgresql://user:pass@ep-shard-8.aws.neon.tech/neondb?sslmode=require
# DB_9=postgresql://user:pass@ep-shard-9.aws.neon.tech/neondb?sslmode=require
# DB_10=postgresql://user:pass@ep-shard-10.aws.neon.tech/neondb?sslmode=require
# DATABASE_BACKUP_FALLBACK=postgresql://user:pass@ep-backup.aws.neon.tech/neondb?sslmode=require
# CC_ID=YourPodName

# Bundle 4 — Canonical Site URL & IndexNow
NEXT_PUBLIC_SITE_URL=https://www.adpauth.com
INDEXNOW_KEY=3a43d612bc8e4666ab867f53bb90557a

# Bundle 6 — Local QA Bypass (Never on production)
# ALLOW_LOCAL_TESTING=1
